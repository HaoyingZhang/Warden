#!/usr/bin/env python3
"""tsq: send a Flux query (read from stdin) to the query gateway and print the JSON reply.

    echo 'from(bucket: "eeg") |> range(start: -1d) |> limit(n: 5)' | tsq [max_rows]
"""
import os
import sys
import urllib.request

max_rows = sys.argv[1] if len(sys.argv) > 1 else "200"
req = urllib.request.Request(f"{os.environ['GATEWAY_URL']}/query?max_rows={max_rows}",
                             data=sys.stdin.buffer.read(), method="POST",
                             headers={"Content-Type": "text/plain"})
try:
    with urllib.request.urlopen(req, timeout=150) as r:
        sys.stdout.write(r.read().decode())
except Exception as e:  # noqa: BLE001
    sys.exit(f"gateway request failed: {e}")
